[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/system_settings_dialog.gd" id="1"]

[node name="SystemSettingsDialog" type="Window"]
title = "System Settings"
size = Vector2i(960, 640)
visible = false
transient = true
exclusive = true
borderless = true
unresizable = true
script = ExtResource("1")

[node name="Background" type="PanelContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_type_variation = &"DialogPanel"

[node name="Layout" type="VBoxContainer" parent="Background"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Background/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "System Settings"

[node name="Scroll" type="ScrollContainer" parent="Background/Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Form" type="VBoxContainer" parent="Background/Layout/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="SoundsLabel" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
text = "UI Sounds:"

[node name="SoundsSelect" type="OptionButton" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
item_count = 2
selected = 0
popup/item_0/text = "Yes"
popup/item_0/id = 0
popup/item_1/text = "No"
popup/item_1/id = 1

[node name="ThemeLabel" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
text = "UI Theme:"

[node name="ThemeSelect" type="OptionButton" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
item_count = 3
selected = 2
popup/item_0/text = "Light"
popup/item_0/id = 0
popup/item_1/text = "Soft"
popup/item_1/id = 1
popup/item_2/text = "Dark"
popup/item_2/id = 2

[node name="UILanguageLabel" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
text = "UI Language:"

[node name="UILanguageSelect" type="OptionButton" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
item_count = 2
selected = 0
popup/item_0/text = "English"
popup/item_0/id = 0
popup/item_1/text = "Español"
popup/item_1/id = 1

[node name="AgentsLanguageLabel" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
text = "Agents Language:"

[node name="AgentsLanguageSelect" type="OptionButton" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
item_count = 2
selected = 0
popup/item_0/text = "None"
popup/item_0/id = 0
popup/item_1/text = "Type"
popup/item_1/id = 1

[node name="AgentsLanguageEdit" type="LineEdit" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
visible = false
layout_mode = 2
max_length = 100
placeholder_text = "Language, e.g. Spanish, English, Japanese..."

[node name="LanguageHint" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
autowrap_mode = 2
text = "None adds no language instruction. Type adds your language to the initial prompt of new agent sessions."

[node name="UserNameLabel" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
text = "Your Name:"

[node name="UserNameEdit" type="LineEdit" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
max_length = 60
placeholder_text = "e.g. Alex"

[node name="UserNameHint" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
autowrap_mode = 2
text = "Agents use this name to address you. Empty adds no instruction."

[node name="RemoteChatLabel" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Remote Chat"

[node name="RemoteChatEnabled" type="CheckBox" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
text = "Enable Remote Chat"

[node name="RemoteChatPortLabel" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
text = "Local port:"

[node name="RemoteChatPort" type="SpinBox" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
min_value = 1024.0
max_value = 65535.0
value = 38471.0

[node name="RemoteChatAccessUrlLabel" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
text = "Phone access URL:"

[node name="RemoteChatAccessUrl" type="LineEdit" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
placeholder_text = "https://desktop.tailnet.ts.net"

[node name="RemoteChatAccessUrlHint" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
autowrap_mode = 2
text = "Use the HTTPS URL from Tailscale Serve. The QR includes this URL and the token."

[node name="RemoteChatTokenLabel" type="Label" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
text = "Access token:"

[node name="RemoteChatToken" type="LineEdit" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
editable = false
secret = true

[node name="RemoteChatActions" type="HBoxContainer" parent="Background/Layout/Scroll/Form"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="RegenerateRemoteChatTokenButton" type="Button" parent="Background/Layout/Scroll/Form/RemoteChatActions"]
unique_name_in_owner = true
layout_mode = 2
text = "Regenerate Token"

[node name="CopyRemoteChatTokenButton" type="Button" parent="Background/Layout/Scroll/Form/RemoteChatActions"]
unique_name_in_owner = true
layout_mode = 2
text = "Copy Token"

[node name="CopyRemoteChatUrlButton" type="Button" parent="Background/Layout/Scroll/Form/RemoteChatActions"]
unique_name_in_owner = true
layout_mode = 2
text = "Copy Local API URL"

[node name="ShowRemoteChatQrButton" type="Button" parent="Background/Layout/Scroll/Form/RemoteChatActions"]
unique_name_in_owner = true
layout_mode = 2
text = "Show QR"

[node name="RemoteChatStatus" type="Label" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 2

[node name="SettingsError" type="Label" parent="Background/Layout/Scroll/Form"]
unique_name_in_owner = true
layout_mode = 2
modulate = Color(1, 0.45, 0.45, 1)
autowrap_mode = 2

[node name="Actions" type="HBoxContainer" parent="Background/Layout"]
layout_mode = 2
alignment = 2
theme_override_constants/separation = 12

[node name="CancelSettingsButton" type="Button" parent="Background/Layout/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Cancel"

[node name="SaveSettingsButton" type="Button" parent="Background/Layout/Actions"]
unique_name_in_owner = true
layout_mode = 2
text = "Save"
