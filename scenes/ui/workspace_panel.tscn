[node name="StartStopButton" type="Button" parent="Root/TaskRow"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
text = "Start"

[node name="ProjectRow" type="HBoxContainer" parent="Root"]
layout_mode = 2

[node name="ProjectPathEdit" type="LineEdit" parent="Root/ProjectRow"]
