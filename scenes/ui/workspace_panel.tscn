[ext_resource type="PackedScene" path="res://scenes/ui/character_view.tscn" id="2_char"]

[sub_resource type="StyleBoxFlat" id="sb_panel"]
bg_color = Color(0.12, 0.13, 0.16, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0

[node name="WorkspacePanel" type="PanelContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("sb_panel")
script = ExtResource("1_ws")

[node name="Root" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Header" type="HBoxContainer" parent="Root"]
layout_mode = 2

[node name="Title" type="Label" parent="Root/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
